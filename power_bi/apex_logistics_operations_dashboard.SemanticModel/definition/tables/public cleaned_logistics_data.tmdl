	column 'distance_miles (bins)' =
			IF(
				ISBLANK('public cleaned_logistics_data'[distance_miles]),
				BLANK(),
				INT('public cleaned_logistics_data'[distance_miles] / 100) * 100
			)
		formatString: 0
		lineageTag: 59caef5f-b8fc-4faa-9cd2-5a2ab5b1d656
		summarizeBy: none

