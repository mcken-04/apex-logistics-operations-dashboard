table 'public cleaned_logistics_data'
	lineageTag: a1a8acba-02f0-4ff0-a668-d7e145f115d7

	measure order_id_count = ```
			
			    COUNT('public cleaned_logistics_data'[orderid])
			```
		formatString: 0
		lineageTag: 43d39b8c-2092-47f7-95fe-52d9a09f5168

	measure On_Time_Delivery_Rate = ```
			
			    VAR Total_Completed_Deliveries =
			        CALCULATE(
			            COUNT('public cleaned_logistics_data'[orderid]), 'public cleaned_logistics_data'[delivery_status] = "Delivered"
			        )
			    VAR On_Time_Deliveries = 
			        CALCULATE(
			            COUNT('public cleaned_logistics_data'[orderid]),
			            'public cleaned_logistics_data'[is_late] = 0,
			            'public cleaned_logistics_data'[delivery_status] = "Delivered"
			        )
			    RETURN
			        DIVIDE(On_Time_Deliveries , Total_Completed_Deliveries, 0)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8dcb277a-ecc1-4c1a-995e-3826f3d5323f

	measure Damage_Rate = ```
			
			    VAR Total_Damged =
			        CALCULATE(
			            COUNT('public cleaned_logistics_data'[orderid]),
			            'public cleaned_logistics_data'[damaged_status] = "Yes"
			        )
			    VAR Total_Orders = 
			        COUNT('public cleaned_logistics_data'[orderid])
			
			    RETURN
			        DIVIDE(Total_Damged, Total_Orders, 0) + 0
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d8e1467a-3ef0-4181-be6f-402417f4cacb

	measure Late_Delivery_Rate = ```
			
			    1 - [On_Time_Delivery_Rate]
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ae5ed389-ad08-422c-8d0c-01726b48a2f0

